# Copia este archivo a .env (el .env real NO se sube al repositorio)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secretpassword
POSTGRES_DB=taller_db
POSTGRES_HOST_PORT=5432
ADMINER_PORT=8080

# Para ejecutar la API y Alembic desde tu máquina (host = localhost).
# Dentro de Docker, compose.yml usa el host "db" automáticamente.
DATABASE_URL=postgresql+psycopg2://postgres:secretpassword@localhost:5432/taller_db
